# --------------------------------------------------------------------------
# Naltech Attendance Mobile Environment Configuration Example
# --------------------------------------------------------------------------
# Salin file ini menjadi .env pada direktori apps/mobile/
# cp .env.example .env
#
# Dapatkan kredensial Firebase dari Firebase Console (Project Settings > General > Your apps)
# atau gunakan FlutterFire CLI: flutterfire configure

FIREBASE_ANDROID_API_KEY=your_android_api_key_here
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
